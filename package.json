{
    "name": "dashmips-debugger",
    "displayName": "dashmips-debugger",
    "description": "Debugs mips while executing in Dashmips interpreter",
    "version": "0.1.15",
    "license": "MIT",
    "publisher": "roadkillco",
    "repository": {
        "type": "git",
        "url": "https://github.com/nbbeeken/dashmips-debugger.git"
    },
    "icon": "images/dashmips-debugger-icon.png",
    "engines": {
        "vscode": "^1.146.0"
    },
    "categories": [
        "Debuggers"
    ],
    "main": "./out/extension.js",
    "activationEvents": [
        "onDebugResolve:mips"
    ],
    "contributes": {
        "menus": {
            "debug/variables/context": [],
            "editor/title": [
                {
                    "command": "View Float",
                    "group": "navigation",
                    "when": "resourceScheme == visual"
                },
                {
                    "command": "View Int",
                    "group": "navigation",
                    "when": "resourceScheme == visual"
                },
                {
                    "command": "View Ascii",
                    "group": "navigation",
                    "when": "resourceScheme == visual"
                }
            ]
        },
        "commands": [
            {
                "command": "View Stack",
                "title": "Dashmips: Visualize the stack"
            },
            {
                "command": "View Heap",
                "title": "Dashmips: Visualize the heap"
            },
            {
                "command": "View Data",
                "title": "Dashmips: Visualize the .data section"
            },
            {
                "command": "View Ascii",
                "title": "Ascii"
            },
            {
                "command": "View Int",
                "title": "Integer"
            },
            {
                "command": "View Float",
                "title": "Float"
            }
        ],
        "configuration": [
            {
                "title": "Dashmips Debugger",
                "properties": {
                    "dashmips.checkDashmipsExists": {
                        "type": "boolean",
                        "default": true,
                        "description": "Check to see if dashmips is installed, will offer to install if not"
                    }
                }
            }
        ],
        "languages": [
            {
                "id": "mips",
                "aliases": [
                    "MIPS",
                    "dashmips",
                    "mips"
                ],
                "extensions": [
                    ".mips",
                    ".dmips"
                ],
                "configuration": "./language/mips-language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "mips",
                "scopeName": "source.mips",
                "path": "./language/mips.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "mips",
                "path": "./language/mips-snippets.json"
            }
        ],
        "breakpoints": [
            {
                "language": "mips"
            }
        ],
        "debuggers": [
            {
                "type": "dashmips",
                "label": "Dashmips",
                "program": "./out/debugAdapter.js",
                "runtime": "node",
                "languages": [
                    "mips"
                ],
                "configurationAttributes": {
                    "launch": {
                        "required": [
                            "program"
                        ],
                        "properties": {
                            "host": {
                                "type": "string",
                                "description": "Host dashmips is running on",
                                "default": "localhost"
                            },
                            "port": {
                                "type": "number",
                                "description": "Port dashmips is running on",
                                "default": 2390
                            },
                            "cwd": {
                                "type": "string",
                                "description": "Path to terminal",
                                "default": "^\"\\${workspaceFolder}\""
                            },
                            "program": {
                                "type": "string",
                                "description": "Path to mips file with main label",
                                "default": "^\"\\${file}\""
                            },
                            "registerFormat": {
                                "enum": [
                                    "hex",
                                    "bin",
                                    "oct",
                                    "dec"
                                ],
                                "type": "string",
                                "description": "Display registers in formats: 'hex' | 'oct' | 'dec' | 'bin'",
                                "default": "hex"
                            },
                            "console": {
                                "enum": [
                                    "integratedTerminal",
                                    "externalTerminal"
                                ],
                                "description": "Where to launch the debug target: integrated terminal, or external terminal.",
                                "default": "integratedTerminal"
                            },
                            "args": {
                                "type": "array",
                                "description": "Arguments for mips program",
                                "default": [],
                                "items": {
                                    "type": "string"
                                }
                            },
                            "dashmipsArgs": {
                                "type": "array",
                                "description": "Arguments for dashmips debugger",
                                "default": [],
                                "items": {
                                    "type": "string"
                                }
                            },
                            "dashmipsCommand": {
                                "type": "string",
                                "description": "The command used to launch dashmips debugger",
                                "default": "python -m dashmips debug"
                            },
                            "stopOnEntry": {
                                "type": "boolean",
                                "description": "Whether or not to stop on first line",
                                "default": false
                            }
                        }
                    },
                    "attach": {
                        "required": [
                            "host",
                            "port"
                        ],
                        "properties": {
                            "host": {
                                "type": "string",
                                "description": "Host dashmips is running on",
                                "default": "localhost"
                            },
                            "port": {
                                "type": "number",
                                "description": "Port dashmips is running on",
                                "default": 2390
                            },
                            "stopOnEntry": {
                                "type": "boolean",
                                "description": "Whether or not to stop on first line",
                                "default": false
                            },
                            "registerFormat": {
                                "enum": [
                                    "hex",
                                    "bin",
                                    "oct",
                                    "dec"
                                ],
                                "type": "string",
                                "description": "Display registers in formats: 'hex' | 'oct' | 'dec' | 'bin'",
                                "default": "hex"
                            }
                        }
                    }
                },
                "initialConfigurations": [],
                "configurationSnippets": [
                    {
                        "label": "Dashmips (Run)",
                        "description": "Run the current MIPS file.",
                        "body": {
                            "type": "dashmips",
                            "request": "launch",
                            "name": "Dashmips (Run)",
                            "program": "^\"\\${file}\""
                        }
                    },
                    {
                        "label": "Dashmips (Run With Logging)",
                        "description": "Run the current MIPS file with logging.",
                        "body": {
                            "type": "dashmips",
                            "request": "launch",
                            "name": "Dashmips (Run With Logging)",
                            "program": "^\"\\${file}\"",
                            "registerFormat": "dec",
                            "cwd": "^\"\\${workspaceFolder}\"",
                            "host": "localhost",
                            "port": 2390,
                            "dashmipsCommand": "python -m dashmips debug",
                            "dashmipsArgs": [
                                "-i",
                                "localhost",
                                "-p",
                                "2390",
                                "-l"
                            ],
                            "args": [],
                            "stopOnEntry": false
                        }
                    },
                    {
                        "label": "Dashmips (Attach)",
                        "description": "Attach to a debugging session of a MIPS file.",
                        "body": {
                            "type": "dashmips",
                            "request": "attach",
                            "name": "Dashmips (Attach)",
                            "registerFormat": "dec",
                            "host": "localhost",
                            "port": 2390,
                            "stopOnEntry": false
                        }
                    }
                ]
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "rimraf ./out && npm run build",
        "build": "tsc",
        "build:test": "tsc -p tsconfig.test.json",
        "package": "vsce package",
        "watch": "tsc --watch",
        "watch:test": "tsc --watch -p tsconfig.test.json",
        "publish": "vsce publish --oidc",
        "pretest": "npm run build && npm run build:test",
        "test": "node ./out-test/test/runTest.js",
        "lint": "eslint --fix --ext ts src test"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^10.0.1",
        "@types/chai": "^5.2.3",
        "@types/glob": "^9.0.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "^26.6.6",
        "@types/vscode": "^1.146.0",
        "@types/webpack": "^5.28.5",
        "@typescript-eslint/eslint-plugin": "^8.72.2",
        "@typescript-eslint/parser": "^8.72.2",
        "@vscode/debugadapter-testsupport": "^1.68.0",
        "@vscode/debugprotocol": "^1.68.0",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^4.1.1",
        "chai": "^6.3.0",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "glob": "^14.0.6",
        "globals": "^17.14.0",
        "mocha": "^12.0.3",
        "prettier": "^3.10.1",
        "rimraf": "^6.1.4",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "utf-8-validate": "^6.0.6"
    },
    "dependencies": {
        "@vscode/debugadapter": "^1.68.0",
        "async-mutex": "^0.5.0"
    }
}
